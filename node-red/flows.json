[
    {
        "id": "ft_tab",
        "type": "tab",
        "label": "FlowTwin supervision",
        "disabled": false,
        "info": "KPIs, the bottleneck OEE proxy and planned-vs-actual alerts from the FlowTwin API (MQTT topics flowtwin/kpis and flowtwin/deviations), shown on the dashboard at /dashboard."
    },
    {
        "id": "ft_broker",
        "type": "mqtt-broker",
        "name": "mosquitto",
        "broker": "mosquitto",
        "port": "1883",
        "clientid": "",
        "autoConnect": true,
        "usetls": false,
        "protocolVersion": "4",
        "keepalive": "60",
        "cleansession": true
    },
    {
        "id": "ft_ui_base",
        "type": "ui-base",
        "name": "FlowTwin",
        "path": "/dashboard",
        "includeClientData": true,
