    {
        "id": "ft_in_kpis",
        "type": "mqtt in",
        "z": "ft_tab",
        "name": "flowtwin/kpis",
        "topic": "flowtwin/kpis",
        "qos": "0",
        "datatype": "json",
        "broker": "ft_broker",
        "x": 140,
        "y": 120,
        "wires": [
            [
                "ft_route",
                "ft_dbg_kpis"
            ]
        ]
    },
    {
        "id": "ft_in_dev",
        "type": "mqtt in",
        "z": "ft_tab",
        "name": "flowtwin/deviations",
        "topic": "flowtwin/deviations",
        "qos": "0",
        "datatype": "json",
        "broker": "ft_broker",
        "x": 160,
        "y": 520,
        "wires": [
            [
                "ft_alert"
            ]
        ]
    },
    {
        "id": "ft_route",
        "type": "function",
        "z": "ft_tab",
        "name": "route KPIs to widgets",
        "func": "// The twin computes the OEE proxy (flowtwin/oee.py) and publishes it with the KPIs;\n// this node only routes values to the dashboard widgets.\nconst k = msg.payload;\nconst o = k.oee || {};\nconst pct = v => Math.round(1000 * (v || 0)) / 10;\nconst last = context.get('t');\ncontext.set('t', k.time_min);\nconst point = {payload: {series: 'throughput', t: k.time_min, thr: k.throughput_per_h}};\nconst chart = (last !== undefined && k.time_min < last) ? [{payload: []}, point] : point;  // new shift: clear first\nreturn [\n    {payload: k.units_out},\n    {payload: k.throughput_per_h},\n    {payload: k.units_out > 0 ? Math.round(100 * k.energy / k.units_out) / 100 : 0},\n    {payload: k.tardiness_min},\n    {payload: pct(o.oee)},\n    {payload: pct(o.availability)},\n    {payload: pct(o.performance)},\n    chart\n];",
        "outputs": 8,
        "x": 420,
        "y": 240,
        "wires": [
            [
                "ft_txt_units"
            ],
            [
                "ft_txt_thr"
            ],
            [
                "ft_txt_energy"
            ],
            [
                "ft_txt_late"
            ],
            [
                "ft_g_oee"
            ],
            [
                "ft_g_av"
            ],
            [
                "ft_g_perf"
            ],
            [
                "ft_chart"
            ]
        ]
    },
    {
        "id": "ft_alert",
        "type": "function",
        "z": "ft_tab",
        "name": "deviation alerts",
        "func": "// Current planned-vs-actual alerts as table rows; a change in alerts also goes to the debug sidebar.\nconst d = msg.payload;\nconst rows = d.products.filter(p => p.alert).map(p => ({order: 'P' + p.product, issue: 'late by ' + p.deviation_min + ' min vs plan'}));\nif (d.flow_alert) rows.push({order: 'line', issue: (-d.flow_gap_units) + ' units behind plan'});\nconst changed = JSON.stringify(rows) !== JSON.stringify(context.get('rows') || []);\ncontext.set('rows', rows);\nreturn [{payload: rows}, rows.length && changed ? {payload: {time_min: d.time_min, alerts: rows}} : null];",
        "outputs": 2,
        "x": 400,
        "y": 520,
        "wires": [
            [
                "ft_table"
            ],
            [
                "ft_dbg_alert"
            ]
        ]
    },
