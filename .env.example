# Copy to .env next to docker-compose.yml; docker compose reads it automatically.

# Address the API (8000), MQTT broker (1883) and Node-RED (1880) listen on. 127.0.0.1 keeps them
# on this machine; 0.0.0.0 exposes them on the network, so protect the Node-RED editor and the
# broker first (README, "Deploy").
FLOWTWIN_BIND=127.0.0.1

# no: the stack starts only when you run docker compose up. unless-stopped: it comes back after a
# reboot or a Docker restart until you stop it.
FLOWTWIN_RESTART=no
